{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "octopuses",
  "version": "0.47.81",
  "identifier": "vip.octopuses.box",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prepare:runtime && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "octopuses",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES/Symphonia-MPL-2.0.txt": "THIRD_PARTY_LICENSES/Symphonia-MPL-2.0.txt",
      "../companion/": "companion/",
      "../api-service/": "api-service/",
      "../browser-extension/": "browser-extension/",
      "runtime/": "runtime/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
